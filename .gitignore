# WordPress test environment (DDEV docroot) - not part of the plugin
/wp/

# Dependencies
# vendor/ is bundled and shipped (mcp-adapter, jetpack autoloader); do not ignore those.
# Dev-only packages from composer require-dev are local and mirror the export-ignore list
# in .gitattributes; keep the two lists in step.
/vendor/bin/
/vendor/dealerdirect/
/vendor/doctrine/
/vendor/myclabs/
/vendor/nikic/
/vendor/phar-io/
/vendor/php-stubs/
/vendor/phpcompatibility/
/vendor/phpcsstandards/
/vendor/phpstan/
/vendor/phpunit/
/vendor/sebastian/
/vendor/squizlabs/
/vendor/szepeviktor/
/vendor/theseer/
/vendor/wp-coding-standards/
/vendor/yoast/
# Generated only when the dev packages above are installed; the shipped tree has no files autoload.
/vendor/composer/autoload_files.php
/node_modules/

# Build artifacts
/build/
*.zip
/release-notes.md

# PHPUnit caches
/.phpunit.cache/
/.phpunit.result.cache

# Environment / secrets
.env
.env.*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*

# Logs
*.log

# Local DB dumps & tool scratch - never part of the plugin
*.sql
/.scratch/
/docs/
/.playwright-cli/
/.playwright/
/.firecrawl/
/.superpowers/
/.impeccable/
/project-state/
/campaign-state/
/.github/release-notes.md

# .ddev/: only the three shareable config files are tracked. Everything else DDEV or an add-on
# drops in there (redis add-on, commands/, addon-metadata/, generated php/) stays local.
/.ddev/*
!/.ddev/config.yaml
!/.ddev/docker-compose.pluginsrc.yaml
!/.ddev/nginx/
# .ddev/php/ is generated and rewritten by DDEV on start; its values are
# machine-local and nothing in the repo depends on them.
/.ddev/php/

# QA evidence screenshots - scratch, never part of the plugin
/public/

# Local working files: harness scripts, probe output, throwaway drafts. Never shipped, and
# Plugin Check reports loose scripts here as application_detected when a scan picks them up.
/scratchpad/

# Python bytecode cache
__pycache__/
*.pyc
