# Dev-only Composer dependencies. The release build runs `composer install --no-dev`,
# so these are normally absent when the tree is deployed; listed here as a backstop in
# case a dev install is ever staged for the build. The runtime deps that DO ship live in
# vendor/wordpress and vendor/composer.
/vendor/bin
/vendor/dealerdirect
/vendor/doctrine
/vendor/myclabs
/vendor/nikic
/vendor/phar-io
/vendor/php-stubs
/vendor/phpcompatibility
/vendor/phpcsstandards
/vendor/phpstan
/vendor/phpunit
/vendor/sebastian
/vendor/squizlabs
/vendor/szepeviktor
/vendor/theseer
/vendor/wp-coding-standards
/vendor/yoast

# Node dev metadata bundled inside the mcp-adapter runtime dependency. Nothing in the
# plugin's PHP runtime touches these; they exist because mcp-adapter's own repo ships a
# package.json/package-lock.json alongside its PHP, and Composer has no mechanism to
# prune non-PHP files from an installed package.
/vendor/wordpress/mcp-adapter/package.json
/vendor/wordpress/mcp-adapter/package-lock.json

# Pattern anchoring, and why several entries above have no leading slash. rsync reads a
# leading slash as anchored to the transfer root and a bare filename as matching at any
# depth. .gitattributes draws the same distinction, and it writes README.md, composer.lock
# and the dev config files unanchored, so git drops the copies Composer installs under
# vendor/ as well as the ones at the root. The entries above match that, which keeps the
# deploy and the zip on the same file set. Do not add the slashes back for tidiness: two
# vendor READMEs and a lock file shipped to wordpress.org that way, in a payload no gate
# had scanned. Directory names stay anchored on purpose, because a bare tests or bin would
# start excluding vendor/*/tests and vendor/*/bin, which git ships.
