#: includes/abilities/media.php:888
msgid "ID of the attachment to update."
msgstr ""

#: includes/abilities/media.php:892
msgid "New attachment title, sanitized as plain text. At least one of title, alt, caption, or description must be given."
msgstr ""

#: includes/abilities/media.php:896
msgid "New alt text for the image, sanitized as plain text."
msgstr ""

#: includes/abilities/media.php:900
msgid "New caption, sanitized as plain text with no HTML."
msgstr ""

#: includes/abilities/media.php:904
msgid "New description. Basic HTML is allowed and sanitized."
msgstr ""

#: includes/abilities/media.php:970
msgid "Provide at least one field to update."
msgstr ""

#: includes/abilities/media.php:1026
msgid "ID of the attachment to permanently delete. Both the file and the library entry are removed; there is no undo."
msgstr ""

#: includes/abilities/menus.php:39
msgid "List menus"
msgstr ""

#: includes/abilities/menus.php:40
msgid "Lists the navigation menus by id, name, slug, and item count. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:47
msgid "Get menu"
msgstr ""

#: includes/abilities/menus.php:48
msgid "Reads one navigation menu by id: its name, slug, and item count. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:55
msgid "List menu items"
msgstr ""

#: includes/abilities/menus.php:56
msgid "Lists the items in a navigation menu by id: each item id, title, URL, what it links to, and its place in the order. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:63
msgid "Create menu"
msgstr ""

#: includes/abilities/menus.php:64
msgid "Creates a navigation menu by name. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:71
msgid "Update menu"
msgstr ""

#: includes/abilities/menus.php:72
#: includes/admin/disclosures.php:118
msgid "Renames a navigation menu by id. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:79
msgid "Delete menu"
msgstr ""

#: includes/abilities/menus.php:80
msgid "Permanently deletes a navigation menu and all of its items. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:87
msgid "Create menu item"
msgstr ""

#: includes/abilities/menus.php:88
msgid "Adds an item (link) to a navigation menu. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:95
msgid "Update menu item"
msgstr ""

#: includes/abilities/menus.php:96
#: includes/admin/disclosures.php:120
msgid "Updates a menu item's title or URL by id. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:103
msgid "Delete menu item"
msgstr ""

#: includes/abilities/menus.php:104
msgid "Permanently removes one item from a navigation menu. Requires the edit-theme-options capability."
msgstr ""

#: includes/abilities/menus.php:196
msgid "ID of the navigation menu to read. An unknown ID, or a term that is not a nav menu, returns a generic error."
msgstr ""

#: includes/abilities/menus.php:255
msgid "ID of the navigation menu whose items to list. An unknown or empty menu returns an empty items list rather than an error."
msgstr ""

#: includes/abilities/menus.php:414
msgid "Name for the new navigation menu. Sanitized as plain text; a duplicate name is refused."
msgstr ""

#: includes/abilities/menus.php:475
msgid "ID of the navigation menu to rename. An unknown ID returns a generic error."
msgstr ""

#: includes/abilities/menus.php:479
msgid "New name for the menu. Sanitized as plain text."
msgstr ""

#: includes/abilities/menus.php:546
msgid "ID of the navigation menu to permanently delete, along with every item inside it. Navigation menus have no Trash, so this cannot be undone."
msgstr ""

#: includes/abilities/menus.php:616
msgid "ID of the navigation menu to add the item to. An unknown ID returns a generic error."
msgstr ""

#: includes/abilities/menus.php:620
msgid "The item's visible link text. Sanitized as plain text."
msgstr ""

#: includes/abilities/menus.php:624
msgid "Destination URL for a custom link item. Sanitized with esc_url_raw. Omit when object_id and type point at an existing post, page, or term instead."
msgstr ""

#: includes/abilities/menus.php:628
msgid "ID of an existing menu item this one should nest under, or omit for a top-level item. Not verified to exist or to belong to this menu before being applied."
msgstr ""

#: includes/abilities/menus.php:632
msgid "ID of the linked post, page, or term when this item points at existing content instead of a custom URL. Required for the post_type and taxonomy types, and it must exist: an id that resolves to nothing is refused rather than saved as a broken link."
msgstr ""

#: includes/abilities/menus.php:636
