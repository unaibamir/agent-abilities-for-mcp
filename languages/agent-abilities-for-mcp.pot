msgid "Lists navigation menus by id, name, slug, and item count. Requires the edit-theme-options capability."
msgstr ""

#: includes/admin/disclosures.php:56
msgid "Reads one navigation menu by id: name, slug, and item count. Requires the edit-theme-options capability."
msgstr ""

#: includes/admin/disclosures.php:57
