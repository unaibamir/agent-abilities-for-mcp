#: includes/abilities/acf-integration.php:64
msgid "List ACF field groups"
msgstr ""

#: includes/abilities/acf-integration.php:65
msgid "Lists the ACF field groups and the fields inside each (key, label, and type) for discovery. It returns structure only, never stored values. Requires the edit-posts capability."
msgstr ""

#: includes/abilities/acf-integration.php:72
msgid "Get post ACF fields"
msgstr ""

#: includes/abilities/acf-integration.php:73
#: includes/admin/disclosures.php:71
msgid "Reads all of a post's ACF field values as a hydrated map keyed by field name. Requires edit access to that post."
msgstr ""

#: includes/abilities/acf-integration.php:80
msgid "Update post ACF fields"
msgstr ""

#: includes/abilities/acf-integration.php:81
msgid "Writes ACF field values on a post by field key, each value sanitized for its field type. Requires edit access to that post."
msgstr ""

#: includes/abilities/acf-integration.php:88
msgid "Get term ACF fields"
msgstr ""

#: includes/abilities/acf-integration.php:89
#: includes/admin/disclosures.php:72
msgid "Reads all of a term's ACF field values as a hydrated map keyed by field name. Requires edit access to that term."
msgstr ""

#: includes/abilities/acf-integration.php:96
msgid "Update term ACF fields"
msgstr ""

#: includes/abilities/acf-integration.php:97
msgid "Writes ACF field values on a term by field key, each value sanitized for its field type. Requires edit access to that term."
msgstr ""

#: includes/abilities/acf-integration.php:104
msgid "Get user ACF fields"
msgstr ""

#: includes/abilities/acf-integration.php:105
msgid "Reads all of a user's ACF field values as a hydrated map keyed by field name. A field of the user_email type returns the real email address under the integration disclaimer. Requires edit access to that user."
msgstr ""

#: includes/abilities/acf-integration.php:112
msgid "Update user ACF fields"
msgstr ""

#: includes/abilities/acf-integration.php:113
msgid "Writes ACF field values on a user by field key, each value sanitized for its field type. Requires edit access to that user."
msgstr ""

#. translators: %s: the field address the caller sent.
#: includes/abilities/acf-integration.php:1029
#, php-format
msgid "This does not exactly name a field, so nothing was written. Send the field's exact name or its field key: %s"
msgstr ""

#. translators: %s: comma-separated list of sub-field addresses the caller sent.
#: includes/abilities/acf-integration.php:1065
#, php-format
msgid "These do not name a sub-field of the field they were sent under, so nothing was written: %s"
msgstr ""

#. translators: %s: comma-separated list of flexible-content row addresses.
#: includes/abilities/acf-integration.php:1129
#, php-format
msgid "Each flexible content row must name one of the field's own layouts in acf_fc_layout. These rows do not, so nothing was written: %s"
msgstr ""

#: includes/abilities/acf-integration.php:1765
msgid "ID of the post whose ACF field values to read. The current user must have edit access to it."
msgstr ""

#: includes/abilities/acf-integration.php:1836
msgid "ID of the post whose ACF field values to write. The current user must have edit access to it."
msgstr ""

#: includes/abilities/acf-integration.php:1841
msgid "Map of ACF field name or field key to its new value. Each key must resolve to a real, defined ACF field (an unresolved key is refused rather than falling back to a raw meta write) and must clear the same protected-key hard-block the meta abilities enforce. Each value is sanitized per the field's ACF type: URL-typed fields via esc_url_raw, wysiwyg/textarea via wp_kses_post, everything else as plain text."
msgstr ""

#: includes/abilities/acf-integration.php:1938
msgid "ID of the term whose ACF field values to read. The current user must have edit access to it."
msgstr ""

#: includes/abilities/acf-integration.php:2003
msgid "ID of the term whose ACF field values to write. The current user must have edit access to it."
msgstr ""

#: includes/abilities/acf-integration.php:2008
msgid "Map of ACF field name or field key to its new value, sanitized and gated exactly like acf-update-post-fields (see that ability for the per-key resolution and hard-block rules)."
msgstr ""

#: includes/abilities/acf-integration.php:2109
msgid "ID of the user whose ACF field values to read. The current user must have edit access to this user. A field of the user_email type returns the real email address (PII), governed by the edit-user capability gate rather than being redacted."
msgstr ""

#: includes/abilities/acf-integration.php:2178
msgid "ID of the user whose ACF field values to write. The current user must have edit access to this user."
msgstr ""

#: includes/abilities/acf-integration.php:2183
msgid "Map of ACF field name or field key to its new value, sanitized and gated exactly like acf-update-post-fields (see that ability for the per-key resolution and hard-block rules). The user-scoped hard-block also blocks capability, session, application-password, and 2FA keys even if a field's storage name collides with one."
msgstr ""

#: includes/abilities/activity-log.php:29
msgid "Get activity log"
msgstr ""

#: includes/abilities/activity-log.php:30
msgid "Reads this plugin's own audit log: each row's ability name, status (started, success, error, denied), acting user id and login, the argument keys passed, the timestamp, and a short identifier-only detail (an object id or slug, a WP_Error code, or a crashed call's exception class and throw site). Most recent first. Response includes total (the count for the status filter). Never argument values or network addresses. Requires the manage-options capability."
msgstr ""

#: includes/abilities/activity-log.php:55
msgid "Filter to entries with exactly this outcome: started, success, error, or denied. Omit to return every status."
msgstr ""

#: includes/abilities/activity-log.php:59
msgid "Filter to entries for exactly this ability name, for example aafm/create-post. Omit to return every ability. The reported total still reflects only the status filter, not this one, and may exceed the number of entries returned."
msgstr ""

#: includes/abilities/activity-log.php:65
#: includes/abilities/blocks.php:138
#: includes/abilities/comments.php:109
#: includes/abilities/comments.php:571
#: includes/abilities/media.php:109
#: includes/abilities/pages.php:99
#: includes/abilities/posts.php:164
#: includes/abilities/revisions.php:95
#: includes/abilities/search.php:65
#: includes/abilities/terms.php:115
#: includes/abilities/users.php:118
msgid "1-based page number for pagination. Defaults to 1."
msgstr ""

#: includes/abilities/activity-log.php:71
msgid "Number of entries per page, clamped to the 1-200 range regardless of the value requested. Defaults to 50 when omitted."
msgstr ""

#: includes/abilities/activity-log.php:93
msgid "Identifier-only note about what the call touched or why it failed, or null when the call recorded none. It is one of an allowlisted identifier (an object id or slug), a WP_Error code, or a crash's exception class and throw site, for example \"WC_Data_Exception at abstract-wc-data.php:1001\". It never contains argument values, free text, or file paths."
msgstr ""

#: includes/abilities/aioseo.php:168
msgid "Get post SEO (All in One SEO)"
msgstr ""

#: includes/abilities/aioseo.php:169
msgid "Reads a post's SEO fields (title, description, canonical, social, and robots) from All in One SEO's own data store, not post meta. Requires edit access to that post."
msgstr ""

#: includes/abilities/aioseo.php:176
msgid "Update post SEO (All in One SEO)"
msgstr ""

#: includes/abilities/aioseo.php:177
msgid "Writes a post's SEO fields through All in One SEO's own data store (not post meta). URL fields are sanitized as URLs. Setting a Twitter field turns off the use-OpenGraph fallback so the Twitter title, description, and image render on their own. Requires edit access to that post."
msgstr ""

#: includes/abilities/aioseo.php:184
msgid "Get post SEO head (All in One SEO)"
msgstr ""

#: includes/abilities/aioseo.php:185
msgid "Reads the rendered SEO head markup for a post from All in One SEO, best-effort: the returned head string is empty when All in One SEO renders no head for that post. Requires the edit-posts capability and edit access to that post."
msgstr ""

#: includes/abilities/aioseo.php:397
msgid "ID of the post whose All in One SEO fields to read. The current user must have edit access to it."
msgstr ""

#: includes/abilities/aioseo.php:443
msgid "ID of the post whose All in One SEO fields to write. The current user must have edit access to it."
msgstr ""

#: includes/abilities/aioseo.php:447
#: includes/abilities/yoast.php:318
msgid "SEO title override for the post."
msgstr ""

#: includes/abilities/aioseo.php:448
#: includes/abilities/yoast.php:319
msgid "Meta description override for the post."
msgstr ""

#: includes/abilities/aioseo.php:449
#: includes/abilities/rankmath.php:410
#: includes/abilities/yoast.php:321
msgid "Canonical URL override for the post, sanitized as a URL."
msgstr ""

#: includes/abilities/aioseo.php:450
#: includes/abilities/rankmath.php:411
#: includes/abilities/yoast.php:322
msgid "Open Graph (Facebook) title override for the post."
msgstr ""

#: includes/abilities/aioseo.php:451
#: includes/abilities/rankmath.php:412
#: includes/abilities/yoast.php:323
msgid "Open Graph (Facebook) description override for the post."
msgstr ""

#: includes/abilities/aioseo.php:452
msgid "Open Graph (Facebook) share image URL. A non-empty value switches AIOSEO's image source to custom so this URL actually renders instead of its default source; clearing the value resets that source only when it was already set to custom."
msgstr ""

#: includes/abilities/aioseo.php:453
msgid "Twitter Card title override. Setting any twitter_* field turns off AIOSEO's use-OpenGraph fallback so this value renders instead of the Facebook/OG title."
msgstr ""

#: includes/abilities/aioseo.php:454
msgid "Twitter Card description override. Setting any twitter_* field turns off AIOSEO's use-OpenGraph fallback so this value renders instead of the Facebook/OG description."
msgstr ""

#: includes/abilities/aioseo.php:455
msgid "Twitter Card share image URL (same custom-source switch as og_image). Setting any twitter_* field also turns off the use-OpenGraph fallback."
msgstr ""

#: includes/abilities/aioseo.php:464
msgid "Whether to noindex this post. Setting either robots flag turns off AIOSEO's 'use site default' robots setting so the explicit flags actually take effect."
msgstr ""

#: includes/abilities/aioseo.php:465
msgid "Whether to nofollow links on this post (see robots_noindex for the site-default interaction this also turns off)."
msgstr ""

#: includes/abilities/aioseo.php:687
msgid "ID of the post to render the All in One SEO head for."
msgstr ""

#: includes/abilities/blocks.php:32
msgid "List blocks"
msgstr ""

#: includes/abilities/blocks.php:33
msgid "Lists reusable blocks (synced patterns) by id, title, slug, status, and modified date. No block markup in the list. Response includes total (the query-wide count of matching blocks; each page omits blocks you lack edit access to, so total can exceed the rows returned). Requires the edit-posts capability."
msgstr ""

#: includes/abilities/blocks.php:40
msgid "Get block"
msgstr ""

#: includes/abilities/blocks.php:41
#: includes/admin/disclosures.php:54
msgid "Reads one reusable block by id, including its raw block markup. Requires edit access to that block."
msgstr ""

#: includes/abilities/blocks.php:48
msgid "Create block"
msgstr ""

#: includes/abilities/blocks.php:49
msgid "Creates a reusable block (published immediately, unless the operator's force-draft setting holds it as a draft). Its markup is sanitized, and the author is always the agent. Requires the publish-posts capability. Put any block styling in the block delimiter attributes, not inline style, or the editor marks the content invalid."
msgstr ""

#: includes/abilities/blocks.php:56
msgid "Update block"
msgstr ""

#: includes/abilities/blocks.php:57
msgid "Updates a reusable block's title or markup by id. The markup is sanitized. Requires edit access to that block. Put any block styling in the block delimiter attributes, not inline style, or the editor marks the content invalid."
msgstr ""

#: includes/abilities/blocks.php:64
msgid "Delete block"
msgstr ""

#: includes/abilities/blocks.php:65
#: includes/admin/disclosures.php:142
msgid "Moves a reusable block to the Trash, where you can restore it. Never a permanent delete. Requires delete access to that block."
msgstr ""

#: includes/abilities/blocks.php:144
msgid "Number of blocks per page, clamped to the 1-100 range regardless of the value requested. Defaults to 20 when omitted."
msgstr ""

#: includes/abilities/blocks.php:148
msgid "Free-text search using WordPress's normal post search, matched against the block's title and content. Omit to list every block you can edit."
msgstr ""

#: includes/abilities/blocks.php:232
msgid "ID of the reusable block to read. The caller must have edit access to this specific block."
msgstr ""

#: includes/abilities/blocks.php:286
msgid "Title for the new reusable block. Sanitized as plain text."
msgstr ""

#: includes/abilities/blocks.php:395
msgid "ID of the reusable block to update. The caller must have edit access to this specific block."
msgstr ""

#: includes/abilities/blocks.php:399
msgid "New title for the block. Sanitized as plain text. Omit to leave the current title unchanged."
msgstr ""

#: includes/abilities/blocks.php:479
msgid "ID of the reusable block to move to the Trash. The caller must have delete access to this specific block. This is a Trash move, not a permanent delete, so it can be restored."
msgstr ""

#: includes/abilities/comments.php:23
msgid "Get comments"
msgstr ""

#: includes/abilities/comments.php:24
msgid "List approved comments for a post (email and IP are never returned)."
msgstr ""

#: includes/abilities/comments.php:31
msgid "Get pending comments"
msgstr ""

#: includes/abilities/comments.php:32
msgid "List the moderation queue (requires moderate_comments)."
msgstr ""

#: includes/abilities/comments.php:39
msgid "Moderate comment"
msgstr ""

#: includes/abilities/comments.php:40
msgid "Approve, unapprove, spam, or trash a comment (requires moderate_comments)."
msgstr ""

#: includes/abilities/comments.php:47
msgid "Get comment"
msgstr ""

#: includes/abilities/comments.php:48
msgid "Read one comment by id (email and IP are never returned). status is usually approved/unapproved/spam/trash; a comment whose parent post is trashed reports status post-trashed - the comment itself was never trashed, its post was."
msgstr ""

#: includes/abilities/comments.php:55
msgid "Create comment"
msgstr ""

#: includes/abilities/comments.php:56
msgid "Add a pending comment to a post as the agent user (requires moderate_comments)."
msgstr ""

#: includes/abilities/comments.php:63
msgid "Update comment"
msgstr ""

#: includes/abilities/comments.php:64
msgid "Edit a comment's content (requires edit access to that comment). The returned comment's status is usually approved/unapproved/spam/trash; because this ability re-reads the comment with no status filter, it can also report post-trashed when the comment's parent post is trashed - the comment itself was never trashed, its post was."
msgstr ""

#: includes/abilities/comments.php:71
msgid "Delete comment"
msgstr ""

#: includes/abilities/comments.php:72
msgid "Permanently delete a comment (not recoverable; use moderate-comment to trash recoverably)."
msgstr ""

#: includes/abilities/comments.php:97
msgid "ID of the post to list comments for. Omit to list approved comments across the whole site, filtered to posts you can read; if given, the post must exist and you must be able to read it."
msgstr ""

#: includes/abilities/comments.php:103
#: includes/abilities/comments.php:565
msgid "Number of comments per page, clamped to the 1-50 range regardless of the value requested. Defaults to 10 when omitted."
msgstr ""

#: includes/abilities/comments.php:303
msgid "ID of the comment to read. An approved comment on a public, non-password-protected post is visible to any logged-in caller; anything else (pending, spam, trashed, or on a hidden post) requires moderation rights on this comment. An unknown ID returns a generic error rather than confirming which IDs exist."
msgstr ""

#: includes/abilities/comments.php:412
msgid "ID of the post to comment on. Must be a real post; creating the comment requires the moderate-comments capability regardless of who owns the post."
msgstr ""

#: includes/abilities/comments.php:422
msgid "Comment body. Sanitized with wp_kses_post, so scripts are stripped but basic HTML survives. The comment is always created pending; it is never auto-published, even for a caller who could otherwise approve comments."
msgstr ""

#: includes/abilities/comments.php:427
msgid "ID of an existing comment to reply to. Must already be a comment on the same post; a comment from a different post is refused. Omit for a top-level comment."
msgstr ""

#: includes/abilities/comments.php:661
msgid "ID of the comment to moderate. The caller must hold moderate-comments and be able to edit this specific comment."
msgstr ""

#: includes/abilities/comments.php:666
msgid "Moderation action: approve (publish the comment), unapprove (return it to the pending queue), spam (mark as spam), or trash (move to the Trash)."
msgstr ""

#: includes/abilities/comments.php:752
msgid "Unsupported moderation action."
msgstr ""

#: includes/abilities/comments.php:809
msgid "ID of the comment to edit. Requires moderate-comments plus edit access to this specific comment."
msgstr ""

#: includes/abilities/comments.php:819
msgid "New comment body. Sanitized with wp_kses_post. Only the body changes here; the parent post, author, email, and IP can never be altered through this ability."
msgstr ""

#: includes/abilities/comments.php:934
msgid "ID of the comment to permanently delete. This bypasses the Trash and cannot be undone; use moderate-comment's trash action instead for a recoverable delete."
msgstr ""

#: includes/abilities/media.php:23
msgid "Get media"
msgstr ""

#: includes/abilities/media.php:24
msgid "List media library items (URL, alt, mime, dimensions). Response includes total (the full match count)."
msgstr ""

#: includes/abilities/media.php:31
msgid "Get media item"
msgstr ""

#: includes/abilities/media.php:32
msgid "Read one media item by id: caption, description, date, filesize, parent, and all image sizes."
msgstr ""

#: includes/abilities/media.php:39
msgid "Count media"
msgstr ""

#: includes/abilities/media.php:40
msgid "Count media library items, total and broken down by mime type."
msgstr ""

#: includes/abilities/media.php:47
msgid "Set featured image"
msgstr ""

#: includes/abilities/media.php:48
msgid "Set a post's featured image to an existing image attachment ID."
msgstr ""

#: includes/abilities/media.php:55
msgid "Upload media"
msgstr ""

#: includes/abilities/media.php:56
msgid "Upload an image from base64 data (jpg, png, gif, webp; SVG rejected)."
msgstr ""

#: includes/abilities/media.php:63
msgid "Update media"
msgstr ""

#: includes/abilities/media.php:64
msgid "Update an attachment's title, alt text, caption, or description."
msgstr ""

#: includes/abilities/media.php:71
msgid "Delete media"
msgstr ""

#: includes/abilities/media.php:72
msgid "Permanently delete an attachment - the file and library entry are removed and cannot be recovered."
