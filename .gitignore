# WordPress test environment (DDEV docroot) - not part of the plugin
/wp/

# Dependencies
# vendor/ is bundled and shipped (mcp-adapter); do not ignore.
/node_modules/

# Build artifacts
/build/
*.zip
/release-notes.md

# PHPUnit caches
/.phpunit.cache/
/.phpunit.result.cache

# Environment / secrets
.env
.env.*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*

# Logs
*.log

# Local DB dumps & tool scratch - never part of the plugin
*.sql
/.scratch/
/docs/
/.playwright-cli/
/.playwright/
/.firecrawl/
/.superpowers/
/.impeccable/
/project-state/
/campaign-state/
/.github/release-notes.md

# Note: .ddev/ is intentionally committed - it is shareable, version-controlled config.
# The exception is .ddev/php/, which DDEV generates and rewrites on start; its values are
# machine-local and nothing in the repo depends on them.
/.ddev/php/

# QA evidence screenshots - scratch, never part of the plugin
/public/

# Local working files: harness scripts, probe output, throwaway drafts. Never shipped, and
# Plugin Check reports loose scripts here as application_detected when a scan picks them up.
/scratchpad/

# Python bytecode cache
__pycache__/
*.pyc
