includes:
	- phpstan-baseline.neon

parameters:
	level: 8
	phpVersion: 70400
	paths:
		- agent-abilities-for-mcp.php
		- includes
		- uninstall.php
	bootstrapFiles:
		- vendor/autoload.php
		- tests/phpstan-bootstrap.php
		- tests/phpstan-stubs.php
	scanFiles:
		- phpstan-polyfill-stubs.stub
	scanDirectories:
		- vendor/wordpress/mcp-adapter
	excludePaths:
		- wp/*
		- tests/*
		- vendor/*
	treatPhpDocTypesAsCertain: false
	reportUnmatchedIgnoredErrors: false
