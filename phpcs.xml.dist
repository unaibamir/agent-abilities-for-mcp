<?xml version="1.0"?>
<ruleset name="Agent Abilities for MCP">
	<description>WordPress Coding Standards for agent-abilities-for-mcp.</description>

	<file>.</file>

	<!-- Scope: our source only. Never lint throwaway core, bundled deps, DDEV tooling, or tests fixtures. -->
	<exclude-pattern>*/wp/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.ddev/*</exclude-pattern>
	<!-- Agent working files. .claude/ is git-excluded and never ships, so throwaway diagnostic
	     scripts left there must not be able to turn the whole gate red. -->
	<exclude-pattern>*/.claude/*</exclude-pattern>
	<!-- Same reasoning for .scratch/: it is git-ignored working space for probes and one-off
	     diagnostic scripts, never shipped, and a leftover probe there must not be able to turn the
	     whole gate red for code that does ship. -->
	<exclude-pattern>*/.scratch/*</exclude-pattern>
	<!-- bin/ holds standalone developer CLIs (e.g. the MCP regression harness) that run with no
	     WordPress bootstrap, so they use fwrite()/curl directly and a single-file class - WPCS does
	     not apply. They are export-ignored from the build and never ship. -->
	<exclude-pattern>*/bin/*</exclude-pattern>
	<!-- The adapter eager-load fixtures deliberately declare classes in the FOREIGN WP\MCP\
	     namespace (and one is an intentional duplicate of another) to reproduce a sibling plugin's
	     pre-declaration of an adapter class. They are throwaway test fixtures, not shipped code. -->
	<exclude-pattern>*/tests/Fixtures/AdapterEager/*</exclude-pattern>
	<!-- The standalone-plugin coexistence fixtures likewise declare classes in the FOREIGN WP\MCP\
	     namespace (some intentionally duplicated) to reproduce the standalone mcp-adapter plugin's
	     unguarded shell-class declaration in both load orders. Throwaway fixtures, never shipped. -->
	<exclude-pattern>*/tests/Fixtures/AdapterShell/*</exclude-pattern>
	<!-- The TEC/Event Tickets stub declares the THIRD-PARTY globals (Tribe__Events__Main,
	     tribe_events(), Tribe__Tickets__Tickets, etc.) this plugin's own TEC integration calls -
	     names it cannot prefix without breaking the very calls it stands in for, and functions
	     PHP requires in the global namespace so unqualified production calls resolve to them.
	     A throwaway test fixture, never shipped, same class as the AdapterEager/AdapterShell
	     exclusions above. -->
	<exclude-pattern>*/tests/stubs/TecStubStore.php</exclude-pattern>
	<!-- Same reasoning as TecStubStore.php above: the GeoDirectory stub declares the THIRD-PARTY
	     globals (geodir_get_post_info(), geodir_save_post_meta()) this plugin's own GeoDirectory
	     integration calls - names it cannot prefix without breaking the calls it stands in for.
	     A throwaway test fixture, never shipped. -->
	<exclude-pattern>*/tests/stubs/GeodirStubStore.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Allow short array syntax across the codebase (modern PHP house style). -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- The cross-type private-read containment test registers an aafm_book CPT with its own
	     capability set; read_private_books is the meta cap WordPress maps for it. Teach the
	     capability sniff about it so the deliberate assertion isn't flagged as a typo.
	     manage_woocommerce is the capability WooCommerce registers on activation and the gate the
	     WooCommerce product abilities use; declare it here so the sniff knows it is a real cap. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="read_private_books"/>
				<element value="manage_woocommerce"/>
				<!-- The Events Calendar's own mapped capability family, confirmed against the
				     installed plugin's capability_type registration for events, venues, and
				     organizers (src/Tribe/Main.php, Venue.php, Organizer.php). -->
				<element value="edit_tribe_event"/>
				<element value="edit_tribe_events"/>
				<element value="edit_others_tribe_events"/>
				<element value="edit_published_tribe_events"/>
				<element value="publish_tribe_events"/>
				<element value="delete_tribe_event"/>
				<element value="delete_tribe_events"/>
				<element value="delete_others_tribe_events"/>
				<element value="delete_published_tribe_events"/>
				<element value="edit_tribe_venue"/>
				<element value="edit_tribe_venues"/>
				<element value="edit_others_tribe_venues"/>
				<element value="edit_published_tribe_venues"/>
				<element value="edit_tribe_organizer"/>
				<element value="edit_tribe_organizers"/>
				<element value="edit_others_tribe_organizers"/>
				<element value="edit_published_tribe_organizers"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="agent-abilities-for-mcp"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="aafm"/>
				<element value="AAFM"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Tests use PSR-4 StudlyCase filenames, self-documenting method names, and the
	     canonical WP test-bootstrap idioms ($_tests_dir, short ternary). WordPress
	     file-naming, doc-comment, prefix, and short-ternary sniffs do not apply to them. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/*</exclude-pattern>
		<!-- The WooCommerce domain files share a _shared.php helper file whose leading
		     underscore makes it sort and load first in the require list, guaranteeing its
		     cross-cutting helpers exist before any domain file references them. The
		     intentional underscore is what the hyphenated-lowercase sniff objects to. -->
		<exclude-pattern>*/includes/abilities/woocommerce/_shared\.php</exclude-pattern>
		<!-- Same reasoning, same convention: the TEC domain files share a _shared.php helper
		     loaded first for the same cross-cutting-helpers-before-siblings guarantee. -->
		<exclude-pattern>*/includes/abilities/tec/_shared\.php</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Universal.Operators.DisallowShortTernary.Found">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Tests assert directly against the database (table existence, row state) by design;
	     the direct-query and caching advisories do not apply to throwaway test queries. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- Tests simulate the Abilities API init actions by pushing onto $wp_current_filter,
	     the documented idiom used by core's own ability test trait. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
